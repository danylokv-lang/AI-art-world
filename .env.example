# Copy to `.env` and fill in to use the real Gemini Director.
# Without a key the app runs on a local heuristic director (fully offline).

# Get a key at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Text model for the Director (cheap + fast). Options: gemini-flash-latest, gemini-2.5-flash
VITE_GEMINI_MODEL=gemini-flash-latest
